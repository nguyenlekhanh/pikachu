# ---------------------------------------------------------------------------
# PIKACHU LIVE US V1 - environment configuration
# Copy this file to `.env` and adjust. Never commit the real `.env`.
# ---------------------------------------------------------------------------

# --- Web server ------------------------------------------------------------
# Port the game server listens on (overlay + admin + websocket + API).
# Must be > 0. The game is a local overlay, not an ephemeral cloud service.
PORT=3000
HOST=0.0.0.0

# Admin dashboard password. CHANGE THIS before you go live.
# The overlay page never receives this value.
ADMIN_TOKEN=change-me-now

# --- Storage ---------------------------------------------------------------
# SQLite file (relative to the project root). The folder is created on boot.
DB_FILE=data/pikachu.db

# --- TikFinity integration -------------------------------------------------
# TikFinity Event API (TikFinity Desktop App must run on this computer).
# Default endpoint documented by TikFinity: ws://localhost:21213/
TIKFINITY_ENABLED=true
TIKFINITY_WS_URL=ws://127.0.0.1:21213/
TIKFINITY_RECONNECT=true

# --- Local mock mode -------------------------------------------------------
# Mock mode is always available for testing, even while TikFinity is connected.
# Set MOCK_SIMULATE=true to auto-generate fake comments/gifts on a timer.
MOCK_MODE=true
MOCK_SIMULATE=false
MOCK_INTERVAL_MS=9000

# --- Background music ------------------------------------------------------
# Tracks live in assets/music/ next to playlist.json (see docs/MUSIC.md).
# MUSIC_ENABLED=false silences the overlay completely; the admin toggle is the
# day-to-day control and works while the feature is enabled.
MUSIC_ENABLED=true
MUSIC_DIR=assets/music

# --- AI providers ----------------------------------------------------------
# Secret used to encrypt saved AI provider API keys at rest (AES-256-GCM).
# Use a long random value and keep it out of version control. If it is empty,
# the server derives a key from ADMIN_TOKEN and shows a warning in the UI.
AI_SECRET=
AI_TIMEOUT_MS=8000

# Optional OpenRouter defaults, importable from Admin -> AI Providers.
# OPENROUTER_URL may be the base URL (https://openrouter.ai/api/v1) or the full
# chat endpoint (https://openrouter.ai/api/v1/chat/completions).
OPENROUTER_URL=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# --- Overlay extras --------------------------------------------------------
# Allow clicking tiles on the overlay page to play (useful for manual testing).
ALLOW_MOUSE_PLAY=true

# Speech synthesis provider hint. "browser" uses the Web Speech API.
# Replace with a server TTS provider later; see client/game/js/voice.js.
TTS_PROVIDER=browser

# Log verbosity: debug | info | warn | error
LOG_LEVEL=info
